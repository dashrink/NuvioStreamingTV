%% ============================================================================
%% DIAGRAM 12: Migration Critical Paths (Priority Order)
%% ============================================================================

graph TB
    subgraph Priority1["Priority 1: Authentication & State (Critical)"]
        Auth["AccountContext + ProfileContext<br/>→ Rust SDK Auth Module"]
        Storage["MMKV Storage<br/>→ Rust Storage Abstraction"]
        PIN["PIN Security (SHA-256)<br/>→ Rust Crypto"]
    end

    subgraph Priority2["Priority 2: TV Navigation (High)"]
        Focus["FocusContext<br/>→ Rust Focus Management"]
        TVNav["TVNavigationContext<br/>→ Native Kotlin/Swift"]
        Focusable["Focusable Components<br/>→ Native UI"]
    end

    subgraph Priority3["Priority 3: Content & Playback (High)"]
        Catalog["CatalogContext + catalogService<br/>→ Rust Catalog Core"]
        Streams["stremioService + Stream Discovery<br/>→ Rust HTTP Client"]
        Downloads["DownloadsContext<br/>→ Rust Download Manager"]
    end

    subgraph Priority4["Priority 4: External Sync (Medium)"]
        TraktSync["TraktContext + traktService<br/>→ Rust API Client"]
        TMDB["tmdbService<br/>→ Rust API Client"]
        Cache["cacheService<br/>→ Rust LRU Cache"]
    end

    subgraph Priority5["Priority 5: UI Layer (Low)"]
        Theme["ThemeContext<br/>→ Native UI Theming"]
        Loading["LoadingContext<br/>→ Native UI State"]
        Toast["ToastContext<br/>→ Native Notifications"]
    end

    Priority1 --> Priority2
    Priority2 --> Priority3
    Priority3 --> Priority4
    Priority4 --> Priority5

    style Priority1 fill:#f44336,stroke:#b71c1c,color:#fff
    style Priority2 fill:#ff9800,stroke:#e65100,color:#fff
    style Priority3 fill:#ffc107,stroke:#f57f17
    style Priority4 fill:#4caf50,stroke:#1b5e20,color:#fff
    style Priority5 fill:#2196f3,stroke:#0d47a1,color:#fff

