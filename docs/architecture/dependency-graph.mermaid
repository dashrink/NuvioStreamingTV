%% Comprehensive Dependency Graph for NuvioStreamingTV
%% This file contains multiple Mermaid diagrams showing module relationships
%% Last Updated: 2026-01-13
%% Purpose: Visual dependency analysis for tri-layer architecture migration

%% ============================================================================
%% DIAGRAM 1: High-Level Architecture Layers
%% ============================================================================

graph TB
    subgraph UI["UI Layer (React Native)"]
        Screens["Screens (50+)"]
        Components["Components (170+)"]
        Hooks["Custom Hooks (38+)"]
        Contexts["Context Providers (15)"]
    end

    subgraph ServiceLayer["Service Layer (29 Services)"]
        DataServices["Data Services"]
        StorageServices["Storage Services"]
        ExternalIntegrations["External Integrations"]
        FeatureServices["Feature Services"]
    end

    subgraph External["External APIs & Native Modules"]
        APIs["TMDB | Trakt | Stremio | MDBList"]
        NativeModules["MMKV | Google Cast | Video Players"]
        FileSystem["File System | expo-file-system"]
    end

    Screens --> Components
    Components --> Hooks
    Hooks --> Contexts
    Contexts --> ServiceLayer
    ServiceLayer --> External

    style UI fill:#e1f5ff,stroke:#01579b
    style ServiceLayer fill:#fff3e0,stroke:#e65100
    style External fill:#f3e5f5,stroke:#4a148c

%% ============================================================================
%% DIAGRAM 2: Context Provider Dependencies
%% ============================================================================

graph TB
    subgraph ContextHierarchy["Context Provider Dependency Hierarchy"]
        PerformanceContext["PerformanceContext<br/>(ROOT - No dependencies)"]
        ThemeContext["ThemeContext"]
        AccountContext["AccountContext"]
        ProfileContext["ProfileContext"]
        FocusContext["FocusContext<br/>(TV Navigation)"]
        TVNavigationContext["TVNavigationContext"]
        TraktContext["TraktContext"]
        DownloadsContext["DownloadsContext"]
        CatalogContext["CatalogContext"]
        GenreContext["GenreContext"]
        LoadingContext["LoadingContext<br/>(Pure UI)"]
        ToastContext["ToastContext"]
        TrailerContext["TrailerContext"]
        HeaderVisibility["HeaderVisibility<br/>(Pure UI)"]
        ScrollToTopContext["ScrollToTopContext<br/>(Pure UI)"]
    end

    subgraph Services["Service Dependencies"]
        mmkvStorage["mmkvStorage"]
        accountService["accountService"]
        settingsService["settingsService"]
        traktService["traktService"]
        storageService["storageService"]
        catalogService["catalogService"]
        tmdbService["tmdbService"]
        cacheService["cacheService"]
        toastService["toastService"]
        trailerService["trailerService"]
    end

    PerformanceContext --> ThemeContext

    AccountContext --> mmkvStorage
    AccountContext --> accountService
    AccountContext --> ProfileContext

    ProfileContext --> mmkvStorage
    ProfileContext --> settingsService
    ProfileContext --> TraktContext
    ProfileContext --> DownloadsContext

    FocusContext --> mmkvStorage
    FocusContext --> TVNavigationContext

    TraktContext --> traktService
    TraktContext --> mmkvStorage

    DownloadsContext --> storageService
    DownloadsContext --> mmkvStorage

    CatalogContext --> catalogService

    GenreContext --> tmdbService
    GenreContext --> cacheService

    ToastContext --> toastService

    TrailerContext --> trailerService

    style PerformanceContext fill:#4caf50,stroke:#1b5e20,color:#fff
    style AccountContext fill:#2196f3,stroke:#0d47a1,color:#fff
    style ProfileContext fill:#2196f3,stroke:#0d47a1,color:#fff
    style FocusContext fill:#ff9800,stroke:#e65100,color:#fff
    style TVNavigationContext fill:#ff9800,stroke:#e65100,color:#fff
    style TraktContext fill:#9c27b0,stroke:#4a148c,color:#fff
    style DownloadsContext fill:#9c27b0,stroke:#4a148c,color:#fff
    style LoadingContext fill:#9e9e9e,stroke:#424242,color:#fff
    style HeaderVisibility fill:#9e9e9e,stroke:#424242,color:#fff
    style ScrollToTopContext fill:#9e9e9e,stroke:#424242,color:#fff

%% ============================================================================
%% DIAGRAM 3: Service Layer Dependencies
%% ============================================================================

graph TB
    subgraph CoreStorage["Core Storage Services (Foundation)"]
        MMKV["mmkvStorage<br/>(Native MMKV)"]
        Cache["cacheService<br/>(In-memory LRU)"]
        Storage["storageService<br/>(File System)"]
    end

    subgraph ExternalAPIs["External API Services"]
        TMDB["tmdbService<br/>TMDB API<br/>40 req/10s"]
        Trakt["traktService<br/>Trakt API (OAuth)<br/>10k req/day"]
        Stremio["stremioService<br/>Stremio Addons"]
        MDBList["mdblistService<br/>MDBList API"]
        Trailer["trailerService<br/>Local/YouTube"]
    end

    subgraph BusinessLogic["Business Logic Services"]
        Catalog["catalogService"]
        Addon["addonService"]
        Account["accountService"]
        Watched["watchedService"]
        Downloads["downloadsService"]
    end

    subgraph Features["Feature Services"]
        Plugin["pluginService"]
        AI["aiService<br/>OpenRouter API"]
        Campaign["campaignService"]
        Notification["notificationService"]
        VideoPlayer["videoPlayerService"]
        Cast["chromecastService"]
    end

    %% Core dependencies
    TMDB --> Cache
    TMDB --> MMKV
    Trakt --> Cache
    Trakt --> MMKV
    Stremio --> Cache
    Stremio --> Addon
    MDBList --> Cache
    Trailer --> MMKV

    Catalog --> Addon
    Catalog -.Intentional Coupling.-> Addon
    Account --> MMKV
    Watched --> MMKV
    Watched --> Trakt
    Downloads --> Storage
    Downloads --> MMKV

    Plugin --> MMKV
    AI --> MMKV
    Campaign --> MMKV
    Notification --> MMKV
    VideoPlayer --> MMKV
    Cast --> MMKV

    Storage --> FileSystemNative["expo-file-system"]

    style MMKV fill:#f44336,stroke:#b71c1c,color:#fff
    style Cache fill:#f44336,stroke:#b71c1c,color:#fff
    style Storage fill:#f44336,stroke:#b71c1c,color:#fff
    style TMDB fill:#4caf50,stroke:#1b5e20,color:#fff
    style Trakt fill:#4caf50,stroke:#1b5e20,color:#fff
    style Stremio fill:#4caf50,stroke:#1b5e20,color:#fff

