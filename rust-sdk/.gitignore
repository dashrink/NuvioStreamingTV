# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo.lock (for libraries, we typically don't commit this)
# Uncomment if you want to track it for reproducible builds
# Cargo.lock

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# Build outputs
*.so
*.dylib
*.dll
*.a

# Editor backup files
*~
\#*\#
.\#*

# Testing
/coverage/

# Logs
*.log

# FFI Bindings
# Note: Generated bindings are currently tracked in version control
# bindings/kotlin/*.kt files are generated by uniffi-bindgen
# bindings/swift/*.swift files are generated by uniffi-bindgen
# Remove this comment and uncomment below to ignore generated bindings:
# /bindings/kotlin/*.kt
# /bindings/swift/*.swift
# /bindings/kotlin/*.h
# /bindings/swift/*.h
# /bindings/kotlin/*.c
# /bindings/swift/*.c
