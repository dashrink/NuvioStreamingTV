# EAS Build ignore file
# Be careful - don't ignore assets folder or other required files

# Dependencies (EAS installs fresh)
node_modules

# Expo cache
.expo

# Build outputs (not source)
dist

# Logs
*.log

# Large media files not needed
*.mp4
*.zip
*.psd
*.mov
*.avi

# Backup and documentation
backup_*/
*.md
.cursor/

# Large directories not needed for build
/ota-builds
/nuvio-providers
/KSPlayer
/exobase
/TrailerServices
server/cache-server
local-scrapers-repo
trakt-docs
trakt-docssandroid/.gradle
screenshots
