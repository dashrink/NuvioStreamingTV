{
  "cli": {
    "version": ">= 16.2.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "apple-tv": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "tv"
      },
      "ios": {
        "simulator": false,
        "image": "latest"
      }
    },
    "android-tv": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "tv"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "extends": "apk",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest"
      }
    },
    "release": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "apk": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    }
  },
  "submit": {
    "production": {}
  }
}